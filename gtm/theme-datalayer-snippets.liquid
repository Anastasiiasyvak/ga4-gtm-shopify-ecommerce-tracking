{%- comment -%}
  Reel Cozy – GA4 e-commerce dataLayer (storefront)
  Pushes e-commerce events to the dataLayer for Google Tag Manager.
  - view_item:        product page
  - view_item_list:   collection pages (incl. Shop All)
  - select_item:      click on a product card in a collection list
  - add_to_cart:      successful add to cart (product page, quick add)
                      + quantity increased in the cart
  - remove_from_cart: item removed or quantity decreased in the cart
  - view_cart:        cart drawer opened by the customer, or /cart page
                      (not the automatic drawer opening after add to cart)
  item_category = first real collection of the product
  (Shopify's default "Home page" collection, handle "frontpage", is skipped).
{%- endcomment -%}

<script>
  window.dataLayer = window.dataLayer || [];

  // Category lookup for cart events: product handle -> first real collection.
  // Built on every page for all products of the store (20 products).
  // Note: Liquid returns max 50 products per collection; a large store
  // would need another source (e.g. a product metafield).
  window.rcCats = {
    {%- for rc_p in collections.all.products -%}
      {%- assign rc_pc = '' -%}
      {%- for rc_c in rc_p.collections -%}
        {%- unless rc_c.handle == 'frontpage' or rc_c.title == 'Home page' -%}
          {%- assign rc_pc = rc_c.title -%}
          {%- break -%}
        {%- endunless -%}
      {%- endfor %}
    {{ rc_p.handle | json }}: {{ rc_pc | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor %}
  };

  {%- if template.name == 'product' and product -%}
    {%- assign rc_variant = product.selected_or_first_available_variant -%}
    {%- assign rc_cat = '' -%}
    {%- for rc_c in product.collections -%}
      {%- unless rc_c.handle == 'frontpage' or rc_c.title == 'Home page' -%}
        {%- assign rc_cat = rc_c.title -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor %}

    rcCats[{{ product.handle | json }}] = {{ rc_cat | json }};

    // view_item: product page
    dataLayer.push({ ecommerce: null });
    dataLayer.push({
      event: 'view_item',
      ecommerce: {
        currency: {{ cart.currency.iso_code | json }},
        value: {{ rc_variant.price | divided_by: 100.0 }},
        items: [{
          item_id: {{ rc_variant.sku | json }},
          item_name: {{ product.title | json }},
          item_brand: {{ product.vendor | json }},
          item_category: {{ rc_cat | json }},
          {%- unless product.has_only_default_variant %}
          item_variant: {{ rc_variant.title | json }},
          {%- endunless %}
          price: {{ rc_variant.price | divided_by: 100.0 }},
          quantity: 1
        }]
      }
    });

  {%- elsif template.name == 'collection' and collection -%}
    {%- assign rc_list_name = collection.title -%}
    {%- if collection.handle == 'all' -%}
      {%- assign rc_list_name = 'Shop All' -%}
    {%- endif -%}

    // List data: product handles (for clicks) and GA4 items, in the same order
    var rcList = {
      currency: {{ cart.currency.iso_code | json }},
      id: {{ collection.handle | json }},
      name: {{ rc_list_name | json }},
      handles: [],
      items: []
    };
    {%- for rc_product in collection.products -%}
      {%- assign rc_v = rc_product.selected_or_first_available_variant -%}
      {%- assign rc_cat = '' -%}
      {%- for rc_c in rc_product.collections -%}
        {%- unless rc_c.handle == 'frontpage' or rc_c.title == 'Home page' -%}
          {%- assign rc_cat = rc_c.title -%}
          {%- break -%}
        {%- endunless -%}
      {%- endfor %}
    rcCats[{{ rc_product.handle | json }}] = {{ rc_cat | json }};
    rcList.handles.push({{ rc_product.handle | json }});
    rcList.items.push({
      item_id: {{ rc_v.sku | json }},
      item_name: {{ rc_product.title | json }},
      item_brand: {{ rc_product.vendor | json }},
      item_category: {{ rc_cat | json }},
      item_list_id: rcList.id,
      item_list_name: rcList.name,
      index: rcList.items.length,
      price: {{ rc_v.price | divided_by: 100.0 }},
      quantity: 1
    });
    {%- endfor %}

    // view_item_list: collection page
    dataLayer.push({ ecommerce: null });
    dataLayer.push({
      event: 'view_item_list',
      ecommerce: {
        currency: rcList.currency,
        item_list_id: rcList.id,
        item_list_name: rcList.name,
        items: JSON.parse(JSON.stringify(rcList.items))
      }
    });

    // select_item: click on a product card in this list
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href*="/products/"]');
      if (!link) return;
      var handle = link.pathname.split('/products/')[1].split('/')[0];
      var i = rcList.handles.indexOf(handle);
      if (i === -1) return;

      dataLayer.push({ ecommerce: null });
      dataLayer.push({
        event: 'select_item',
        ecommerce: {
          currency: rcList.currency,
          item_list_id: rcList.id,
          item_list_name: rcList.name,
          items: [JSON.parse(JSON.stringify(rcList.items[i]))]
        }
      });
    });
  {%- endif %}

  // Cart events: add_to_cart and remove_from_cart
  // They fire only after Shopify confirms the change.
  (function () {
    if (window.rcFetchWrapped) return;
    window.rcFetchWrapped = true;

    var currency = {{ cart.currency.iso_code | json }};
    var originalFetch = window.fetch;
    var rcCart = null; // snapshot of the cart: line key -> line

    // Read the current cart from Shopify and save a snapshot
    function loadCart() {
      return originalFetch('/cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); });
    }
    function snapshot(cart) {
      var map = {};
      (cart.items || []).forEach(function (line) { map[line.key] = line; });
      return map;
    }
    loadCart().then(function (cart) { rcCart = snapshot(cart); }).catch(function () {});

    // Turn a Shopify cart line into a GA4 item
    function toItem(line, qty) {
      var item = {
        item_id: line.sku,
        item_name: line.product_title,
        item_brand: line.vendor,
        item_category: rcCats[line.handle] || '',
        price: line.final_price / 100,
        quantity: qty
      };
      if (line.variant_title && line.variant_title !== 'Default Title') {
        item.item_variant = line.variant_title;
      }
      return item;
    }

    function pushCartEvent(eventName, items) {
      if (!items.length) return;
      var value = 0;
      items.forEach(function (it) { value += it.price * it.quantity; });
      dataLayer.push({ ecommerce: null });
      dataLayer.push({
        event: eventName,
        ecommerce: {
          currency: currency,
          value: Math.round(value * 100) / 100,
          items: items
        }
      });
    }

    // view_cart: all items currently in the cart
    function viewCart() {
      loadCart().then(function (cart) {
        rcCart = snapshot(cart);
        var items = (cart.items || []).map(function (line) {
          return toItem(line, line.quantity);
        });
        pushCartEvent('view_cart', items);
      }).catch(function () {});
    }

    var lastAddAt = 0; // time of the last "add to cart" request

    {%- if template.name == 'cart' %}
    // view_cart: /cart page
    viewCart();
    {%- endif %}

    // view_cart: cart drawer opened by the customer.
    // The drawer is a <dialog>; we watch for its "open" attribute.
    // The drawer also opens automatically after add to cart:
    // that is not a separate view_cart, so we skip it (3 seconds window).
    var lastViewAt = 0; // time of the last view_cart (protection from duplicates)

    new MutationObserver(function (mutations) {
      mutations.forEach(function (m) {
        var el = m.target;
        if (el.tagName !== 'DIALOG' || !el.hasAttribute('open')) return;
        if (m.oldValue !== null) return; // was already open: not a new opening
        if (!el.closest('cart-drawer-component, [class*="cart-drawer"], [id*="cart-drawer"]')) return;
        if (Date.now() - lastAddAt < 3000) return; // automatic opening after add to cart
        if (Date.now() - lastViewAt < 1000) return; // same opening reported twice
        lastViewAt = Date.now();
        viewCart();
      });
    }).observe(document.documentElement, {
      attributes: true,
      subtree: true,
      attributeFilter: ['open'],
      attributeOldValue: true
    });

    window.fetch = function (input, init) {
      var request = originalFetch.apply(this, arguments);
      var url = typeof input === 'string' ? input : (input && input.url) || '';

      // 1) Add to cart: product page button or quick add
      if (url.indexOf('/cart/add') !== -1) {
        lastAddAt = Date.now();
        var addedQty = 1;
        try {
          var body = init && init.body;
          if (body instanceof FormData && body.get('quantity')) {
            addedQty = parseInt(body.get('quantity'), 10) || 1;
          } else if (typeof body === 'string') {
            var parsed = JSON.parse(body);
            var q = parsed.quantity || (parsed.items && parsed.items[0] && parsed.items[0].quantity);
            addedQty = parseInt(q, 10) || 1;
          }
        } catch (err) {}

        request.then(function (response) {
          if (!response.ok) return; // e.g. out of stock
          response.clone().json().then(function (data) {
            var lines = data.items ? data.items : [data];
            var items = [];
            lines.forEach(function (line) {
              if (!line || !line.variant_id) return;
              var qty = lines.length === 1 ? addedQty : (line.quantity || 1);
              items.push(toItem(line, qty));
            });
            pushCartEvent('add_to_cart', items);
            return loadCart().then(function (cart) { rcCart = snapshot(cart); });
          }).catch(function () {});
        }).catch(function () {});
      }

      // 2) Cart changes: trash icon, +/- buttons, quantity field
      else if (/\/cart\/(change|update|clear)/.test(url)) {
        request.then(function (response) {
          if (!response.ok || !rcCart) return;
          var before = rcCart;
          loadCart().then(function (cart) {
            var after = snapshot(cart);
            var removed = [];
            var added = [];

            // Compare every line before and after the change
            Object.keys(before).forEach(function (key) {
              var oldQty = before[key].quantity;
              var newQty = after[key] ? after[key].quantity : 0;
              if (newQty < oldQty) removed.push(toItem(before[key], oldQty - newQty));
              if (newQty > oldQty) added.push(toItem(after[key], newQty - oldQty));
            });

            pushCartEvent('remove_from_cart', removed);
            pushCartEvent('add_to_cart', added);
            rcCart = after;
          }).catch(function () {});
        }).catch(function () {});
      }

      return request;
    };
  })();
</script>
